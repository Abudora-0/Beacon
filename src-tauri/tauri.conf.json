{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beacon",
  "mainBinaryName": "Beacon",
  "version": "1.2.0",
  "identifier": "com.beacon.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Beacon",
        "width": 1320,
        "height": 840,
        "minWidth": 940,
        "minHeight": 620,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
